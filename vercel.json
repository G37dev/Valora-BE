{
    "version": 2,
    "regions": [
        "sin1"
    ],
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/admin/cron/all-tick",
            "schedule": "0 0 * * *"
        }
    ]
}