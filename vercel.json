{
    "version": 2,
    "builds": [
        {
            "src": "index.js",
            "use": "@vercel/node"
        }
    ],
    "functions": {
        "index.js": {
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "index.js"
        }
    ],
    "crons": [
        {
            "path": "/api/admin/cron/installment-tick",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/admin/cron/loan-tick",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/admin/cron/price-tick",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/admin/cron/queue-drain",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/admin/cron/chain-events-tick",
            "schedule": "*/5 * * * *"
        }
    ]
}